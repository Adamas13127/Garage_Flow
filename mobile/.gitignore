# Ce fichier ignore les fichiers locaux generes par Expo et npm.
# Il existe pour eviter de commiter des dependances, builds ou secrets.
# Il communique avec Git uniquement.

node_modules/
.expo/
dist/
build/
.env
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# Projets natifs generes par expo prebuild / expo run (regenerables, jamais versionnes)
android/
ios/

# Artefacts de build natifs
.gradle/
local.properties
*.keystore
*.apk
*.aab
